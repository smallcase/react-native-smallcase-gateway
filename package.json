{
  "name": "react-native-smallcase-gateway",
  "title": "React Native Smallcase Gateway",
  "version": "7.7.3",
  "description": "smallcase gateway bindings for react native",
  "main": "src/index.js",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "types",
    "react-native-smallcase-gateway.podspec",
    "!lib/typescript/example",
    "!lib/typescript/smart_investing_react_native",
    "!android/build",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "types": "types/index.d.ts",
  "scripts": {
    "test": "jest",
    "typescript": "tsc --noEmit",
    "genTypes": "tsc src/index.js --declaration --emitDeclarationOnly --allowJs --noLib --outDir types",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{js,ts,tsx}\" --fix",
    "format": "prettier --write \"**/*.{js,ts,tsx,json}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json}\"",
    "prepare": "bob build",
    "example": "yarn --cwd example",
    "bootstrap": "yarn example && yarn && yarn example pods",
    "commit": "yarn cz",
    "prepack": "scripts/fetch-ios-sdks.sh",
    "fetch-ios-sdks": "scripts/fetch-ios-sdks.sh"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": "https://github.com/smallcase/react-native-smallcase-gateway",
  "author": "smallcase mobile <mobile@smallcase.com> (https://github.com/smallcase)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/smallcase/react-native-smallcase-gateway/issues"
  },
  "homepage": "https://github.com/smallcase/react-native-smallcase-gateway#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@arkweid/lefthook": "^0.7.7",
    "@babel/core": "^7.28.6",
    "@babel/eslint-parser": "^7.18.2",
    "@babel/preset-react": "^7.28.5",
    "@commitlint/config-conventional": "^17.0.2",
    "@react-native-community/eslint-config": "^3.0.2",
    "@types/jest": "^28.1.2",
    "@types/react": "~17.0.21",
    "@types/react-native": "0.68.0",
    "commitlint": "^17.0.2",
    "eslint": "^8.4.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "^28.1.1",
    "pod-install": "^0.1.0",
    "prettier": "^2.0.5",
    "react-native-builder-bob": "^0.18.3",
    "typescript": "^4.5.2"
  },
  "resolutions": {
    "@types/react": "17.0.21"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/",
      "<rootDir>/smart_investing_react_native/node_modules"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "volta": {
    "node": "25.4.0",
    "yarn": "1.19.2"
  }
}
